config target="train" version=2 {
  use "presets/model/mmdit_576.kdl"
  use "presets/training/bf16_adamw.kdl"
  use "presets/data/latent_cache_576.kdl"

  model {
    checkpoint null
  }

  training {
    batch_size 4
    grad_accum_steps 1
    max_steps 100000
  }

  data {
    dataset_path "data/train"
  }

  output {
    dir "runs/train"
  }
}
