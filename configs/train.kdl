config target="train" version=2 {
  model {
    use "mmdit_576"
    checkpoint null
  }

  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }

  text {
    use "clip_l_t5_base"
  }

  training {
    use "bf16_adamw"
    batch_size 1
    grad_accum_steps 4
    max_steps 100000
    num_workers 0
    persistent_workers false
  }

  data {
    use "latent_cache_576"
    dataset_path "data/dataset"
  }

  output {
    dir "runs/train"
  }
}
