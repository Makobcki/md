config target="train" version=2 {
  model {
    family "pixart_sigma"
    variant "pixart_sigma_tiny"
    architecture {
      image_size 32
      latent_size 4
      latent_channels 4
      patch_size 2
      hidden_size 32
      depth 1
      num_heads 4
      caption_channels 16
      cross_attention_dim 32
      max_text_tokens 8
    }
    diffusion {
      objective "rectified_flow"
      prediction_type "velocity"
    }
  }
  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }
  training {
    batch_size 2
    max_steps 1
  }
  output {
    dir "runs/train_pixart_sigma_tiny"
  }
}
