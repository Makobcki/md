config target="eval" version=2 {
  model {
    use "mmdit_576"
    checkpoint "runs/mmdit_base/2026-05-04_164714_001/ckpt_0038000.pt"
  }

  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }

  sampler {
    use "rf_heun"
  }

  eval {
    prompt_root "data/eval_prompts"
    out_dir "runs/eval"
    seed 42
    steps 28
    cfg 4.5
    n_per_prompt 1
  }
}
