config target="sample" version=1 {
  model {
    use "var_d16"
    checkpoint "./runs/train/2026-05-08_201645_001/checkpoints/step_002000.pt"
  }

  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }

  sampler {
    use "rf_euler"
  }

  sampling {
    steps 30
    guidance_scale 4.5
    seed 42
    n 1
  }

  prompt {
    text ""
    negative ""
  }

  output {
    dir "outputs/sample"
  }
}
