config target="sample" version=2 {
  model {
    use "mmdit_576"
    checkpoint "runs/mmdit_base/2026-05-04_164714_001/ckpt_0038000.pt"
  }

  sampler {
    use "rf_euler"
  }

  sampling {
    steps 30
    guidance_scale 4.5
    seed 42
    n 1
  }

  prompt {
    text ""
    negative ""
  }

  output {
    dir "outputs/sample"
  }
}
