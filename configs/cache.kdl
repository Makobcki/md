config target="cache" version=2 {
  model {
    use "mmdit_576"
  }

  text {
    use "clip_l_t5_base"
  }

  training {
    use "bf16_adamw"
  }

  data {
    use "latent_cache_576"
    dataset_path "data/dataset"
  }

  cache {
    latent_cache true
    text_cache true
    strict true
    validate_on_start true
    auto_prepare true
  }

  output {
    dir "runs/cache"
  }
}
