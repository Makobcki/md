preset kind="model" name="pixart_sigma_512" version=1 {
  model {
    family "pixart_sigma"
    variant "pixart_sigma_512"

    architecture {
      image_size 512
      latent_size 64
      latent_channels 4
      patch_size 2
      hidden_size 1152
      depth 28
      num_heads 16
      mlp_ratio 4.0
      qk_norm true
      caption_channels 4096
      cross_attention_dim 1152
      max_text_tokens 300
    }

    diffusion {
      objective "rectified_flow"
      prediction_type "velocity"
      timestep_embedding "sinusoidal"
    }
  }

  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }
}
