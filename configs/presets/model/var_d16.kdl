preset kind="model" name="var_d16" version=1 {
  model {
    family "var"
    variant "var_d16"

    architecture {
      image_size 256
      depth 16
      hidden_size 1024
      num_heads 16
      mlp_ratio 4.0
      drop_path 0.0
      scale_schedule [1, 2, 3, 4, 5, 6, 8, 10, 13, 16]
      max_token_length 680
    }

    tokenizer {
      kind "vq"
      codebook_size 4096
      codebook_dim 32
      downsample_factor 16
      checkpoint null
    }

    autoregressive {
      objective "next_scale_prediction"
      prediction_type "token_logits"
      conditioning "none"
      causal_mode "scale_causal"
      loss "cross_entropy"
    }
  }
}
