preset kind="model" name="mmdit_1024" version=1 {
  model {
    family "mmdit"
    variant "1024"

    architecture {
      image_size 1024
      latent_channels 16
      patch_size 2
      hidden_size 1536
      depth 28
      num_heads 24
      double_stream_blocks 18
      single_stream_blocks 10
    }

    diffusion {
      objective "rectified_flow"
      prediction_type "velocity"
    }
  }

  image_size 1024
  latent_downsample_factor 8
}
