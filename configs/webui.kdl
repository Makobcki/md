config target="webui" version=1 {
  model {
    use "mmdit_576"
    checkpoint "runs/mmdit_base/2026-05-04_164714_001/ckpt_0038000.pt"
  }

  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }

  sampler {
    use "rf_euler"
  }

  webui {
    use "local"
    host "127.0.0.1"
    port 7860
    auto_open true
  }
}
