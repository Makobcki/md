config target="train" version=2 {
  model {
    use "../presets/model/mmdit_576.kdl"
    checkpoint null
  }

  text {
    use "../presets/text/clip_l_t5_base.kdl"
  }

  training {
    use "../presets/training/bf16_adamw.kdl"
    batch_size 1
    grad_accum_steps 4
    max_steps 100000
    num_workers 0
    persistent_workers false
  }

  data {
    use "../presets/data/latent_cache_576.kdl"
    dataset_path "data/dataset"
  }

  output {
    dir "runs/train"
  }
}
