config target="cache" version=2 {
  model {
    use "../presets/model/mmdit_576.kdl"
  }

  vae {
    pretrained "stabilityai/sd-vae-ft-mse"
    scaling_factor 0.18215
    downsample_factor 8
    latent_channels 4
  }

  text {
    use "../presets/text/clip_l_t5_base.kdl"
  }

  training {
    use "../presets/training/bf16_adamw.kdl"
  }

  data {
    use "../presets/data/latent_cache_576.kdl"
    dataset_path "data/dataset"
  }

  cache {
    latent_cache true
    text_cache true
    strict true
    validate_on_start true
    auto_prepare true
  }

  output {
    dir "runs/cache"
  }
}
