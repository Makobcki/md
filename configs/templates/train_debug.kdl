config target="train" version=2 {
  model {
    use "../presets/model/mmdit_576.kdl"
    checkpoint null
  }

  text {
    use "../presets/text/fake_debug.kdl"
  }

  training {
    use "../presets/training/single_gpu_bf16_debug.kdl"
  }

  data {
    use "../presets/data/latent_cache_576.kdl"
    dataset_path "data/dataset"
  }

  output {
    dir "runs/debug"
  }
}
