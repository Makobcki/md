preset kind="data" name="my_latent_cache" version=1 {
  image_size 576
  latent_cache true
  latent_cache_dir ".cache/latents_576"
  latent_cache_index "index.jsonl"
  text_cache true
  text_cache_dir ".cache/text"

  data {
    image_dir "images"
    meta_dir ""
    tags_dir ""
    caption_field "caption"
    require_512 false
  }
}
