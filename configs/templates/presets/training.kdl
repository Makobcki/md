preset kind="training" name="my_training" version=1 {
  training {
    optimizer {
      name "adamw"
      lr 0.0001
      weight_decay 0.0001
    }

    precision {
      amp true
      dtype "bf16"
      tf32 true
    }

    batch_size 1
    grad_accum_steps 8
    max_steps 100000
  }

  latent_dtype "bf16"
}
