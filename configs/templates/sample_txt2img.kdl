config target="sample" version=2 {
  model {
    use "mmdit_576"
    checkpoint "checkpoints/model.safetensors"
  }

  sampler {
    use "rf_heun"
  }

  sampling {
    steps 28
    guidance_scale 4.5
    seed 42
    n 1
  }

  prompt {
    text ""
    negative ""
  }

  output {
    dir "outputs/sample"
  }
}
