  }

  sampler {
    use "../presets/sampler/rf_heun.kdl"
  }

  sampling {
    steps 28
    guidance_scale 4.5
    seed 42
    n 1
  }

  prompt {
    text ""
    negative ""
  }

  output {
    dir "outputs/sample"
  }
}
